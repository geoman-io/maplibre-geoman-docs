{
  "build": {
    "env": {
      "ENABLE_EXPERIMENTAL_COREPACK": "1"
    }
  },
  "installCommand": "pnpm config set \"//npm.geoman.io/:_authToken\" \"$NPM_TOKEN_GEOMAN\" && pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/docs/maplibre/",
      "destination": "/docs/maplibre",
      "permanent": true
    }
  ],  
  "rewrites": [
    {
      "source": "/docs/maplibre",
      "destination": "/"
    },
    {
      "source": "/docs/maplibre/:path*",
      "destination": "/:path*"
    }
  ]
}