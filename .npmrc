engine-strict=true
@geoman-io:registry=https://npm.geoman.io/
# Auth token is NOT stored here: pnpm 11 refuses to expand ${ENV} in a committed
# project .npmrc. Locally it lives in the user pnpm config, loaded from
# geoman/.env as NPM_TOKEN_GEOMAN. Vercel sets the same variable on every
# environment and applies it in installCommand before install.
